# Copy to .env and fill in. Never commit .env.

# Public domain name; its DNS A/AAAA record must point at this server.
HEFZUL_DOMAIN=tasks.example.com
# Email for Let's Encrypt certificate notices.
HEFZUL_ACME_EMAIL=you@example.com

# Generate both with: openssl rand -hex 32
HEFZUL_JWT_SECRET=
HEFZUL_DB_PASSWORD=

HEFZUL_TIMEZONE=Asia/Dhaka
# Container image built by .github/workflows/hefzul-image.yml.
HEFZUL_IMAGE=ghcr.io/hefzulinnovations/hefzul-tasks:main

# Optional: outgoing mail for reminders and password resets.
HEFZUL_MAILER_ENABLED=false
HEFZUL_MAILER_HOST=
HEFZUL_MAILER_PORT=587
HEFZUL_MAILER_USERNAME=
HEFZUL_MAILER_PASSWORD=
HEFZUL_MAILER_FROMEMAIL=

# Nightly backup, in HEFZUL_TIMEZONE. Local copies older than KEEP_DAYS are pruned.
HEFZUL_BACKUP_TIME=02:30
HEFZUL_BACKUP_KEEP_DAYS=14

# Off-site backup target (pick one, or leave HEFZUL_OFFSITE_REMOTE empty).
# HEFZUL_OFFSITE_REMOTE is "offsite:<bucket-or-folder>/<path>".
HEFZUL_OFFSITE_REMOTE=
# S3-compatible (Backblaze B2, Wasabi, Cloudflare R2, AWS ...):
#   HEFZUL_OFFSITE_TYPE=s3
#   HEFZUL_OFFSITE_S3_PROVIDER=Other
#   HEFZUL_OFFSITE_S3_ENDPOINT=https://s3.example.com
#   HEFZUL_OFFSITE_S3_ACCESS_KEY_ID=
#   HEFZUL_OFFSITE_S3_SECRET_ACCESS_KEY=
#   HEFZUL_OFFSITE_S3_REGION=
#   HEFZUL_OFFSITE_REMOTE=offsite:my-bucket/hefzul-tasks
# WebDAV (Nextcloud, ownCloud, a NAS ...):
#   HEFZUL_OFFSITE_TYPE=webdav
#   HEFZUL_OFFSITE_WEBDAV_URL=https://cloud.example.com/remote.php/dav/files/me
#   HEFZUL_OFFSITE_WEBDAV_VENDOR=nextcloud
#   HEFZUL_OFFSITE_WEBDAV_USER=
#   HEFZUL_OFFSITE_WEBDAV_PASS_OBSCURED=   (run: docker run --rm rclone/rclone obscure 'your-password')
#   HEFZUL_OFFSITE_REMOTE=offsite:backups/hefzul-tasks
HEFZUL_OFFSITE_TYPE=
